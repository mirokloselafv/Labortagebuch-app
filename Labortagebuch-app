function metric(label,val,unit=''){return`<div class="metric"><b>${val||'—'}${val&&unit?' '+unit:''}</b><span>${label}</span></div>`}function additionSummary(e){const fields=[['OW',e.ow],['LW',e.lw],['HCM',e.hcm],['HHW',e.hhw],['HHB',e.hhb],['P14',e.p14],['WK',e.wk],['EN',e.en],['VIT',e.vit],['pH-W',e.phw],['pH-B',e.phb],['pH+',e.phplus]];const values=fields.filter(([,v])=>v!==undefined&&v!=='').map(([k,v])=>`${k}: ${v}`);if(!values.length&&e.addition)return e.addition;return values.length?values.join(' · '):'—'}
