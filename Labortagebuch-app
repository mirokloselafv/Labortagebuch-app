function drawChart(id,keys,min,max){const data=visibleEntries();const c=$(id),ctx=c.getContext('2d'),ratio=devicePixelRatio||1,w=c.clientWidth,h=210;c.width=w*ratio;c.height=h*ratio;ctx.scale(ratio,ratio);ctx.clearRect(0,0,w,h);const pad={l:35,r:10,t:13,b:25};const iw=w-pad.l-pad.r,ih=h-pad.t-pad.b;ctx.font='10px system-ui';ctx.strokeStyle='#d6e3ea';ctx.fillStyle='#5f7285';for(let j=0;j<=4;j++){const y=pad.t+ih*j/4;ctx.beginPath();ctx.moveTo(pad.l,y);ctx.lineTo(w-pad.r,y);ctx.stroke();ctx.fillText((max-(max-min)*j/4).toFixed(max<3?2:0),3,y+3)}if(!data.length)return;const n=Math.max(data.length-1,1);const times=data.map(e=>{const t=new Date(e.date).getTime();return Number.isFinite(t)?t:NaN});const validTimes=times.filter(Number.isFinite);const timeMin=validTimes.length?Math.min(...validTimes):0,timeMax=validTimes.length?Math.max(...validTimes):0,timeSpan=Math.max(timeMax-timeMin,1);keys.forEach((key,ki)=>{ctx.strokeStyle=ki===0?'#0064aa':(id==='ecChart'?'#f0a46b':'#8cd2c8');ctx.lineWidth=2.3;ctx.setLineDash(ki? [5,4]:[]);ctx.beginPath();let started=false;data.forEach((e,i)=>{const v=parseFloat(e[key]);if(!Number.isFinite(v))return;const timestamp=times[i];const x=Number.isFinite(timestamp)&&timeMax>timeMin?pad.l+iw*(timestamp-timeMin)/timeSpan:pad.l+iw*i/n,y=pad.t+ih*(max-v)/(max-min);if(!started){ctx.moveTo(x,y);started=true}else ctx.lineTo(x,y);ctx.fillStyle=ctx.strokeStyle;ctx.beginPath();ctx.arc(x,y,2.7,0,Math.PI*2);ctx.fill();ctx.beginPath();ctx.moveTo(x,y)});ctx.stroke();ctx.setLineDash([])});ctx.fillStyle='#5f7285';const firstLabel=chartDateLabel(data[0].date),lastLabel=chartDateLabel(data[data.length-1].date);ctx.fillText(firstLabel,pad.l,h-7);if(data.length>1)ctx.fillText(lastLabel,Math.max(pad.l,w-72),h-7)}
