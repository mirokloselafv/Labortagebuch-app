<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Labortagebuch</title>
<link rel="manifest" href="manifest.webmanifest">
<meta name="theme-color" content="#0064aa">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<link rel="apple-touch-icon" href="icons/icon-192.png">
<style>
:root{--ink:#102a43;--blue:#0064aa;--teal:#8cd2c8;--aqua:#96d2d2;--warm:#f0d2b4;--paper:#f7fbfc;--line:#d6e3ea;--muted:#5f7285;--danger:#b64040;--shadow:0 12px 35px rgba(16,42,67,.10)}
*{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}button,input,select,textarea{font:inherit}button{cursor:pointer}.shell{max-width:1250px;margin:auto;padding:20px clamp(14px,3vw,34px) 48px}.masthead{display:flex;justify-content:space-between;align-items:flex-start;gap:20px;margin-bottom:18px}.eyebrow{font-size:.74rem;letter-spacing:.18em;text-transform:uppercase;color:var(--blue);font-weight:800}.title{font-size:clamp(2rem,5vw,4.2rem);line-height:.94;letter-spacing:-.06em;margin:.35rem 0 .6rem;font-weight:850}.subtitle{max-width:680px;color:var(--muted);margin:0;line-height:1.5}.pulse{width:70px;height:70px;border-radius:50%;background:var(--blue);box-shadow:0 0 0 12px var(--aqua),0 0 0 24px rgba(240,210,180,.7);margin:8px 16px 0 0;flex:0 0 auto}.toolbar{display:flex;flex-wrap:wrap;gap:9px;margin:18px 0}.btn{border:1px solid var(--blue);background:var(--blue);color:white;border-radius:10px;padding:10px 14px;font-weight:750;box-shadow:0 4px 10px rgba(0,100,170,.12)}.btn.secondary{background:white;color:var(--blue)}.btn.tertiary{background:var(--teal);border-color:var(--teal);color:var(--ink)}.btn.danger{background:white;border-color:#e3b8b8;color:var(--danger);box-shadow:none}.btn:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible{outline:3px solid var(--warm);outline-offset:2px}.grid{display:grid;grid-template-columns:minmax(0,1.08fr) minmax(0,.92fr);gap:18px;align-items:start}.card{background:white;border:1px solid var(--line);border-radius:18px;box-shadow:var(--shadow);padding:18px;overflow:hidden}.card h2{font-size:1.05rem;margin:0 0 14px;letter-spacing:-.02em}.card h3{font-size:.85rem;text-transform:uppercase;letter-spacing:.1em;color:var(--muted);margin:18px 0 10px}.form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,220px));gap:10px;justify-content:start}.conditions-grid{grid-template-columns:repeat(4,minmax(0,1fr));max-width:none;gap:8px}.conditions-grid .field label{min-height:2.25em;display:flex;align-items:flex-end}.conditions-grid input,.conditions-grid select{font-size:.8rem;padding-left:7px;padding-right:7px}.measurement-grid{grid-template-columns:repeat(4,minmax(0,1fr));max-width:none;gap:8px}.measurement-grid .field{padding:8px;border-radius:10px;border:1px solid transparent}.measurement-grid .field label{color:var(--ink)}.measurement-grid .ph-before{background:#eef9f6;border-color:#d6eee8}.measurement-grid .ph-after{background:#dcefe9;border-color:#c2e2d9}.measurement-grid .ec-before{background:#fff8f0;border-color:#f5dfc7}.measurement-grid .ec-after{background:#f8eadc;border-color:#ecd4bb}.measurement-grid .level-before{background:#eff8fc;border-color:#d3e8f1}.measurement-grid .level-after{background:#dfedf5;border-color:#c4dce9}.measurement-grid select{background:rgba(255,255,255,.8)}.measurement-grid .level-before,.measurement-grid .level-after{grid-column:span 2}.addition-grid{grid-template-columns:repeat(4,minmax(0,1fr));max-width:none}.addition-four{grid-template-columns:repeat(4,minmax(0,1fr))}.addition-pair{grid-template-columns:repeat(2,minmax(0,220px))}.addition-three{grid-template-columns:repeat(3,minmax(0,220px))}.addition-two{grid-template-columns:repeat(2,minmax(0,220px))}.addition-colors + .addition-colors{margin-top:18px}.addition-colors .field{border:1px solid transparent;border-radius:10px;padding:8px}.addition-colors select,.addition-colors input{background:rgba(255,255,255,.78)}.addition-colors .ow,.addition-colors .lw{background:#dcecf5;border-color:#b9d6e4}.addition-colors .hcm{background:linear-gradient(135deg,#8cd2c8,#121c1b);border-color:#719b94;color:#102a43}.addition-colors .hhw{background:#f5e6a8;border-color:#ddc96f}.addition-colors .hhb{background:#8cd2c8;border-color:#5bb7a8}.addition-colors .p14{background:#8bbbd3;border-color:#5a9cbd}.addition-colors .wk{background:#e7b0b0;border-color:#cf8585}.addition-colors .en{background:#f0c092;border-color:#dca16b}.addition-colors .vit{background:linear-gradient(135deg,#f0c092,#f5e6a8,#fff);border-color:#e2c896}.addition-colors .phw{background:#e8f7f5;border-color:#b9e5de}.addition-colors .phb{background:#fff8dc;border-color:#ebd98c}.addition-colors .phplus{background:#f5dede;border-color:#e5b6b6}.charge-bar{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px;align-items:end;margin:0 0 18px}.charge-bar .field{margin:0}.charge-bar .btn{min-height:38px;padding:8px 11px;width:100%;white-space:nowrap}.field{display:flex;flex-direction:column;gap:5px;min-width:0}.field.full{grid-column:1/-1;max-width:450px}.field label{font-size:.76rem;font-weight:800;color:var(--muted)}input,select,textarea{width:100%;min-width:0;border:1px solid var(--line);background:#fbfdfe;border-radius:9px;padding:8px 9px;color:var(--ink);min-height:38px}select{appearance:auto}.field.full .unit{max-width:220px}textarea{min-height:82px;resize:vertical}.unit{position:relative}.unit input{padding-right:42px}.unit span{position:absolute;right:11px;top:11px;color:var(--muted);font-size:.84rem}.section-head{display:flex;align-items:center;justify-content:space-between;gap:10px}.badge{font-size:.74rem;color:var(--blue);background:#e8f5fb;border-radius:999px;padding:5px 8px;font-weight:800}.dropzone{border:1.5px dashed #9fc3d3;border-radius:12px;padding:14px;background:#f6fbfd;text-align:center;color:var(--muted)}.dropzone input{display:none}.dropzone label{display:inline-block;color:var(--blue);font-weight:800;cursor:pointer}.thumbs{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:10px}.thumb{position:relative;aspect-ratio:1;border-radius:9px;overflow:hidden;background:#eaf2f5;border:1px solid var(--line)}.thumb img{width:100%;height:100%;object-fit:cover}.thumb button{position:absolute;right:4px;top:4px;width:24px;height:24px;border:0;border-radius:50%;background:rgba(16,42,67,.82);color:white}.savebar{position:static;z-index:3;margin-top:16px;padding:10px;background:rgba(247,251,252,.9);backdrop-filter:blur(10px);border:1px solid var(--line);border-radius:14px;display:flex;gap:9px;justify-content:flex-end}.entries{display:flex;flex-direction:column;gap:10px}.entry{border:1px solid var(--line);border-radius:12px;padding:12px;background:linear-gradient(135deg,#fff,#f8fcfd)}.entry-top{display:flex;justify-content:space-between;gap:8px;align-items:center}.entry-day{font-weight:900;color:var(--blue)}.entry-time{font-size:.78rem;color:var(--muted)}.entry-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:10px}.metric{background:#f3f8fa;padding:8px;border-radius:8px}.metric b{display:block;font-size:.9rem}.metric span{font-size:.7rem;color:var(--muted)}.empty{color:var(--muted);padding:30px 8px;text-align:center;border:1px dashed #aac4cf;border-radius:12px}.charts{margin-top:18px}.chart-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}.chart-wrap{border:1px solid var(--line);border-radius:12px;padding:8px;background:#fff}.chart-wrap h3{margin:4px 4px 8px;font-size:.78rem}.chart-wrap canvas{width:100%;height:210px;display:block}.legend{font-size:.7rem;color:var(--muted);display:flex;gap:11px;flex-wrap:wrap;padding:5px}.legend i{display:inline-block;width:10px;height:3px;vertical-align:middle;margin-right:3px}.info{font-size:.78rem;color:var(--muted);line-height:1.45;margin-top:11px}.status{font-size:.8rem;color:var(--muted);min-height:1.2em;margin:4px 0 0}.hidden{display:none!important}@media(max-width:900px){.grid{grid-template-columns:1fr}.chart-grid{grid-template-columns:1fr 1fr}.conditions-grid{grid-template-columns:repeat(4,minmax(0,1fr));gap:6px}.measurement-grid{grid-template-columns:repeat(4,minmax(0,1fr));gap:5px}.charge-bar{grid-template-columns:1fr 1fr}.addition-four{grid-template-columns:repeat(4,minmax(0,1fr));gap:6px}}@media(max-width:560px){.shell{padding:16px 11px 34px}.masthead{gap:8px}.pulse{width:38px;height:38px;margin:7px 8px 0 0;box-shadow:0 0 0 7px var(--aqua),0 0 0 14px rgba(240,210,180,.7)}.form-grid,.addition-grid,.addition-pair,.addition-three,.addition-two,.charge-bar{grid-template-columns:1fr}.conditions-grid{grid-template-columns:1fr;gap:8px}.measurement-grid{grid-template-columns:repeat(4,minmax(0,1fr));gap:3px}.measurement-grid .level-before,.measurement-grid .level-after{grid-column:span 2}.conditions-grid .field label,.measurement-grid .field label,.addition-four .field label{font-size:.68rem;letter-spacing:-.02em}.conditions-grid input,.conditions-grid select,.measurement-grid select,.measurement-grid input,.addition-four select{padding:7px 5px;font-size:.78rem;min-height:38px}.measurement-grid .field{padding:5px 4px}.conditions-grid .unit span{display:none}.field.full{grid-column:auto}.chart-grid{grid-template-columns:1fr}.entry-grid{grid-template-columns:repeat(2,1fr)}.savebar{justify-content:stretch}.savebar .btn{flex:1}}
/* Finales Layout-Fix: keine Überläufe, gleichmäßige Feldachsen */
.grid{grid-template-columns:minmax(0,1.18fr) minmax(360px,.82fr)}
.charge-bar{grid-template-columns:repeat(2,minmax(0,1fr)) !important;width:100%;gap:9px}
.charge-bar>.field,.charge-bar>.btn{min-width:0}
.charge-bar>.btn{width:100%;white-space:normal;line-height:1.15}
.conditions-grid{grid-template-columns:repeat(4,minmax(0,1fr));align-items:start}
.conditions-grid>.field{min-width:0;align-self:start}
.conditions-grid .field label{min-height:2.25em;line-height:1.15;display:flex;align-items:flex-end}
.conditions-grid input,.conditions-grid select{width:100%;min-width:0;font-size:.74rem;padding-left:5px;padding-right:5px}
.conditions-grid input[type=datetime-local]{letter-spacing:-.035em}
@media(max-width:900px){.grid{grid-template-columns:1fr}.charge-bar{grid-template-columns:1fr 1fr !important}.conditions-grid{grid-template-columns:repeat(4,minmax(0,1fr))}}
@media(max-width:560px){.charge-bar{grid-template-columns:1fr !important}.conditions-grid{grid-template-columns:1fr;gap:8px}.conditions-grid .field label{min-height:0}.conditions-grid input,.conditions-grid select{font-size:.9rem;padding-left:8px;padding-right:8px}.measurement-grid .level-before,.measurement-grid .level-after{grid-column:span 2}.measurement-grid .level-before input,.measurement-grid .level-after input{font-size:.95rem;padding-left:8px;padding-right:36px;min-width:0}}
</style>
</head>
<body>
<div class="shell">
  <header class="masthead">
    <div><h1 class="title">Labor-<br>tagebuch</h1></div>
    <div class="pulse" aria-hidden="true"></div>
  </header>
  <div class="toolbar"><button class="btn secondary" id="newBtn">Neuer Eintrag</button><button class="btn secondary" id="exportCsv">CSV exportieren</button><button class="btn secondary" id="exportJson">Backup exportieren</button><button class="btn secondary" id="importBtn">Backup importieren</button><input class="hidden" id="importFile" type="file" accept="application/json"></div>
  <div class="grid">
    <section class="card" aria-labelledby="formTitle"><div class="section-head"><h2 id="formTitle">Tagesprotokoll</h2><span class="badge" id="dayBadge">Messung 1</span></div>
      <form id="entryForm">
        <div class="charge-bar">
          <div class="field"><label for="chargeSelect">Charge auswählen</label><select id="chargeSelect"><option value="">— neue Charge —</option></select></div>
          <div class="field"><label for="chargeName">Chargenname</label><input id="chargeName" type="text" placeholder="z. B. Charge A-01" autocomplete="off"></div>
          <button class="btn secondary" type="button" id="saveChargeBtn">Charge speichern</button><button class="btn tertiary" type="button" id="newChargeBtn">Neue Charge</button>
        </div>
        <h3>Rahmenbedingungen</h3><div class="form-grid conditions-grid">
          <div class="field"><label for="date">Datum / Uhrzeit</label><input id="date" type="datetime-local" required></div>
          <div class="field"><label for="size">Größe</label><div class="unit"><input id="size" type="number" step="0.1" min="0" inputmode="decimal" placeholder="z. B. 25"><span>cm</span></div></div>
          <div class="field"><label for="roomTemp">Raumtemperatur</label><select id="roomTemp"></select></div>
          <div class="field"><label for="humidity">Relative Luftfeuchtigkeit</label><select id="humidity"></select></div>
        </div>
        <h3>Messwerte</h3><div class="form-grid measurement-grid">
          <div class="field ph-before"><label for="phBefore">pH vor</label><select id="phBefore"></select></div><div class="field ec-before"><label for="ecBefore">EC vor (mS/cm)</label><select id="ecBefore"></select></div>
          <div class="field ph-after"><label for="phAfter">pH nach</label><select id="phAfter"></select></div><div class="field ec-after"><label for="ecAfter">EC nach (mS/cm)</label><select id="ecAfter"></select></div>
          <div class="field level-before"><label for="levelBefore">Füllstand vor</label><div class="unit"><input id="levelBefore" list="levelOptions" type="number" step="1" min="0" inputmode="numeric"><span>mL</span></div></div><div class="field level-after"><label for="levelAfter">Füllstand nach</label><div class="unit"><input id="levelAfter" list="levelOptions" type="number" step="1" min="0" inputmode="numeric"><span>mL</span></div></div>
        </div>
        <h3>Temperatur Nährlösung</h3><div class="form-grid"><div class="field full"><div class="unit"><input id="nutrientTemp" type="number" step="0.1" inputmode="decimal"><span>°C</span></div></div></div>
        <h3>Zugabe</h3>
        <div class="form-grid addition-pair addition-colors"><div class="field ow"><label for="ow">OW</label><input id="ow" list="quantityOptions" type="number" step="1" min="0" max="10000" inputmode="numeric"></div><div class="field lw"><label for="lw">LW</label><input id="lw" list="quantityOptions" type="number" step="1" min="0" max="10000" inputmode="numeric"></div></div>
        <div class="form-grid addition-four addition-colors"><div class="field hcm"><label for="hcm">HCM</label><select id="hcm"></select></div><div class="field hhw"><label for="hhw">HHW</label><select id="hhw"></select></div><div class="field hhb"><label for="hhb">HHB</label><select id="hhb"></select></div><div class="field p14"><label for="p14">P14</label><select id="p14"></select></div></div>
        <div class="form-grid addition-three addition-colors"><div class="field wk"><label for="wk">WK</label><select id="wk"></select></div><div class="field en"><label for="en">EN</label><select id="en"></select></div><div class="field vit"><label for="vit">VIT</label><select id="vit"></select></div></div>
        <div class="form-grid addition-three addition-colors"><div class="field phw"><label for="phw">pH-W</label><input id="phw" type="text" inputmode="text" autocomplete="off" placeholder="Zahl oder Text"></div><div class="field phb"><label for="phb">pH-B</label><input id="phb" type="text" inputmode="text" autocomplete="off" placeholder="Zahl oder Text"></div><div class="field phplus"><label for="phplus">pH+</label><input id="phplus" type="text" inputmode="text" autocomplete="off" placeholder="Zahl oder Text"></div></div>
        <datalist id="levelOptions"></datalist><datalist id="quantityOptions"></datalist>
        
<h3>Bilder</h3><div class="dropzone"><label for="images">Bilder auswählen</label><input id="images" type="file" accept="image/*" multiple><div>Fotos aus der Galerie oder Kamera hinzufügen</div></div><div class="thumbs" id="thumbs"></div>
        <h3>Notizen</h3><div class="field"><label for="notes">Sonstiges</label><textarea id="notes" placeholder="Beobachtungen, Abweichungen, nächste Schritte …"></textarea></div>
        <div class="savebar"><button class="btn danger" type="button" id="clearBtn">Leeren</button><button class="btn" type="submit">Eintrag speichern</button></div><div class="status" id="status" role="status"></div>
      </form>
    </section>
    <section class="card"><div class="section-head"><h2>Protokoll</h2><span class="badge" id="countBadge">0 Einträge</span></div><div class="entries" id="entries"></div><p class="info">Die Web-App speichert Einträge im Browser, sofern dieser lokale Speicherung erlaubt. Für ein geräteübergreifendes Backup regelmäßig <b>Backup exportieren</b> verwenden.</p></section>
  </div>
  <section class="card charts"><div class="section-head"><h2>Verlauf</h2><span class="badge">Aktuelle Charge</span></div><div class="chart-grid"><div class="chart-wrap"><h3>Größe (cm)</h3><canvas id="sizeChart" aria-label="Verlauf der Größe in Zentimetern"></canvas><div class="legend"><span><i style="background:#0064aa"></i>Größe</span></div></div><div class="chart-wrap"><h3>Füllstand (mL)</h3><canvas id="levelChart" aria-label="Verlauf des Füllstands"></canvas><div class="legend"><span><i style="background:#0064aa"></i>vor</span><span><i style="background:#8cd2c8"></i>nach</span></div></div><div class="chart-wrap"><h3>pH-Wert</h3><canvas id="phChart" aria-label="Verlauf des pH-Werts"></canvas><div class="legend"><span><i style="background:#0064aa"></i>vor</span><span><i style="background:#8cd2c8"></i>nach</span></div></div><div class="chart-wrap"><h3>EC (mS/cm)</h3><canvas id="ecChart" aria-label="Verlauf des EC-Werts"></canvas><div class="legend"><span><i style="background:#0064aa"></i>vor</span><span><i style="background:#f0a46b"></i>nach</span></div></div></div></section>
</div>
<script>
const $=id=>document.getElementById(id);let entries=[];let editingId=null;let stagedImages=[];let currentCharge='';let charges=[];const DB='labortagebuch-db-v1';
function optionLabel(id,value){const labels={phBefore:'pH vor',phAfter:'pH nach',ecBefore:'EC vor',ecAfter:'EC nach',roomTemp:'Raumtemp.',humidity:'RLF',hcm:'HCM',hhw:'HHW',hhb:'HHB',p14:'P14',wk:'WK',en:'EN',vit:'VIT'};const label=labels[id]||'Auswahl';return`${label} · ${String(value).replaceAll('.',',')}`}function addSelectOption(select,value,text){const o=document.createElement('option');o.value=value;o.textContent=text??optionLabel(select.id,value);select.appendChild(o)}function opts(select,min,max,step,decimals){select.innerHTML='<option value="">—</option>';for(let v=min;v<=max+1e-9;v+=step){let x=v.toFixed(decimals);addSelectOption(select,x)}}
opts($('phBefore'),4,8,.1,1);opts($('phAfter'),4,8,.1,1);opts($('ecBefore'),.05,2.5,.05,2);opts($('ecAfter'),.05,2.5,.05,2);function rangeOptions(id,min,max,step,decimals){const s=$(id);s.innerHTML='<option value="">—</option>';for(let v=min;v<=max+1e-9;v+=step){const x=v.toFixed(decimals);addSelectOption(s,x)}}function specialOptions(id,values){const s=$(id);s.innerHTML='<option value="">—</option>';values.forEach(x=>addSelectOption(s,x))}function datalistOptions(id,min,max,step,decimals){const s=$(id);for(let v=min;v<=max+1e-9;v+=step){const o=document.createElement('option');o.value=v.toFixed(decimals);s.appendChild(o)}}function initSelects(){const temps=['<18'];for(let v=18;v<=30.0001;v+=.5)temps.push(v.toFixed(1));temps.push('>30');specialOptions('roomTemp',temps);const humid=['<30'];for(let v=30;v<=75;v++)humid.push(String(v));humid.push('>75');specialOptions('humidity',humid);const hcm=[];for(let v=0;v<=1.0001;v+=.1)hcm.push(v.toFixed(1));for(let v=1.5;v<=10.0001;v+=.5)hcm.push(v.toFixed(1));specialOptions('hcm',hcm);rangeOptions('hhw',0,50,1,0);rangeOptions('hhb',0,50,1,0);rangeOptions('p14',0,25,.5,1);rangeOptions('wk',0,50,1,0);rangeOptions('en',0,25,.5,1);rangeOptions('vit',0,5,1,0);datalistOptions('levelOptions',0,10000,1,0);datalistOptions('quantityOptions',0,10000,1,0)}initSelects();
function nowLocal(){const d=new Date();d.setMinutes(d.getMinutes()-d.getTimezoneOffset());return d.toISOString().slice(0,16)}function resetForm(){const keepCharge=currentCharge||$('chargeName').value.trim();editingId=null;$('entryForm').reset();currentCharge=keepCharge;$('chargeName').value=keepCharge;$('chargeSelect').value=keepCharge;$('date').value=nowLocal();stagedImages=[];renderThumbs();updateBadge();$('status').textContent=''}
function readForm(){return {id:editingId||crypto.randomUUID(),charge:$('chargeName').value.trim(),date:$('date').value,size:$('size').value,roomTemp:$('roomTemp').value,humidity:$('humidity').value,phBefore:$('phBefore').value,phAfter:$('phAfter').value,ecBefore:$('ecBefore').value,ecAfter:$('ecAfter').value,levelBefore:$('levelBefore').value,levelAfter:$('levelAfter').value,nutrientTemp:$('nutrientTemp').value,ow:$('ow').value,lw:$('lw').value,hcm:$('hcm').value,hhw:$('hhw').value,hhb:$('hhb').value,p14:$('p14').value,wk:$('wk').value,en:$('en').value,vit:$('vit').value,phw:$('phw').value,phb:$('phb').value,phplus:$('phplus').value,notes:$('notes').value,images:stagedImages}}
function fillForm(e){editingId=e.id;currentCharge=e.charge||'';populateCharges();for(const k of ['date','size','roomTemp','humidity','phBefore','phAfter','ecBefore','ecAfter','levelBefore','levelAfter','nutrientTemp','ow','lw','hcm','hhw','hhb','p14','wk','en','vit','phw','phb','phplus','notes'])$(k).value=e[k]??'';$('chargeName').value=currentCharge;$('chargeSelect').value=currentCharge;stagedImages=e.images||[];renderThumbs();updateBadge();scrollTo({top:0,behavior:'smooth'})}
function chargeNames(){return [...new Set([...charges,...entries.map(e=>e.charge).filter(Boolean)])].sort((a,b)=>a.localeCompare(b,'de'))}function populateCharges(){const s=$('chargeSelect');const keep=currentCharge;s.innerHTML='<option value="">— neue Charge —</option>';chargeNames().forEach(name=>{const o=document.createElement('option');o.value=name;o.textContent=name;s.appendChild(o)});s.value=keep||''}function saveAll(){try{localStorage.setItem('labortagebuch.entries',JSON.stringify(entries));localStorage.setItem('labortagebuch.charges',JSON.stringify(chargeNames()))}catch(e){}}function loadAll(){try{entries=JSON.parse(localStorage.getItem('labortagebuch.entries')||'[]');charges=JSON.parse(localStorage.getItem('labortagebuch.charges')||'[]')}catch(e){entries=[];charges=[]}entries.sort((a,b)=>a.date.localeCompare(b.date));populateCharges();render()}
function renderThumbs(){const box=$('thumbs');box.innerHTML='';stagedImages.forEach((src,i)=>{const d=document.createElement('div');d.className='thumb';d.innerHTML=`<img src="${src}" alt="Bild ${i+1}"><button type="button" aria-label="Bild entfernen">×</button>`;d.querySelector('button').onclick=()=>{stagedImages.splice(i,1);renderThumbs()};box.appendChild(d)})}
